    <string name="transfer_error_title">Import nicht möglich</string>

    <string name="transfer_export_title">Katalog exportieren</string>
    <string name="transfer_export_hint">Schreibt eine JSON-Datei mit allen Fragen, Löschmarken und Statistiken. Dieselbe Datei lässt sich wieder importieren – jeder Export ist damit ein prüfbares Backup und ein Abgleichspaket für ein zweites Gerät.</string>
    <string name="transfer_export_action">Exportieren</string>
    <string name="transfer_export_filter">Nur ausgewählte Kategorien</string>
    <string name="transfer_export_filter_hint">Die Datei bleibt abgleichfähig, weil das Format identisch ist.</string>
    <string name="transfer_export_done">Export geschrieben</string>

    <string name="transfer_import_title">Katalog importieren</string>
    <string name="transfer_import_hint">Die App rechnet den Import zuerst nur durch und zeigt das Ergebnis. Geschrieben wird erst nach Bestätigung – und davor legt sie ein internes Backup an.</string>
    <string name="transfer_import_action">Datei auswählen</string>

    <string name="transfer_mode_title">Importmodus</string>
    <string name="transfer_mode_merge">Zusammenführen</string>
    <string name="transfer_mode_merge_hint">Der Geräte-Abgleich. Fragen werden zusammengeführt, Statistiken der Datei ignoriert.</string>
    <string name="transfer_mode_restore">Wiederherstellen</string>
    <string name="transfer_mode_restore_hint">Ersetzt den gesamten lokalen Bestand durch die Datei, Statistiken inklusive.</string>
    <string name="transfer_restore_warning_title">Bestand vollständig ersetzen?</string>
    <string name="transfer_restore_warning_text">Wiederherstellen löscht alle %1$d lokalen Fragen und Statistiken und ersetzt sie durch den Inhalt der Datei. Das lässt sich nur über ein Backup zurückholen.</string>
    <string name="transfer_restore_confirm">Ersetzen</string>

    <string name="transfer_csv_title">Fragen aus Tabelle anlegen</string>
    <string name="transfer_csv_hint">Spalten: question, answer, category, difficulty, tags. Kein Abgleichsformat – ohne IDs und Zeitstempel ist jede Zeile eine neue Frage.</string>
    <string name="transfer_csv_action">Tabelle auswählen</string>

